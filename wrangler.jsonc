// Cloudflare (Workers + statik dosyalar) yayın ayarı.
// Yalnızca derlenmiş dist/ klasörü yayınlanır; derleme komutu Cloudflare panelinde:
//   npm ci --omit=dev --no-audit --no-fund && npm run paketle
// _headers ve _redirects dosyaları dist/ içindedir ve Cloudflare tarafından okunur.
{
  "name": "tentiforverse",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
