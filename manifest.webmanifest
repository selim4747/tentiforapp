{
  "name": "TentiforApp — Tentiforverse Arşivi",
  "short_name": "TentiforApp",
  "description": "Tentiforverse evren arşivi: karakterler, kozmoloji, isim sistemi, takvim ve oyunlar.",
  "lang": "tr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "background_color": "#F4F9FD",
  "theme_color": "#F4F9FD",
  "icons": [
    {
      "src": "ikon/ikon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "ikon/ikon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "ikon/ikon-maskeli-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Roman",
      "short_name": "Roman",
      "url": "./#/roman",
      "icons": [
        {
          "src": "ikon/ikon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Oyunlar",
      "short_name": "Oyna",
      "url": "./#/oyunlar",
      "icons": [
        {
          "src": "ikon/ikon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Fan hikâyesi yaz",
      "short_name": "Fan",
      "url": "./#/fanHikaye",
      "icons": [
        {
          "src": "ikon/ikon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Claude'un Evreni",
      "short_name": "Claude",
      "url": "./#/claude",
      "icons": [
        {
          "src": "ikon/ikon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "id": "./",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "categories": [
    "books",
    "entertainment",
    "games"
  ],
  "share_target": {
    "action": "./paylasim-al",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "baslik",
      "text": "metin",
      "url": "adres",
      "files": [
        {
          "name": "dosya",
          "accept": [
            "text/html",
            ".html",
            ".htm",
            "application/json",
            ".json"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/html": [
          ".html",
          ".htm"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ]
}
